{
  "name": "adonis-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Filter library (query builder + Lucid adapter) for the Agora AdonisJS ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-filter.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs && biome check --write .",
    "release": "pnpm --filter './packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@swc/core": "1.16.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}
