{
  "name": "adonis-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Filter library (query builder + Lucid adapter) for the Agora AdonisJS ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-filter.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write .",
    "release": "pnpm --filter './packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@swc/core": "1.15.47",
    "unplugin-swc": "1.5.10"
  }
}
