{{#var filterFileName = string(entity.name).snakeCase().removeSuffix('filter').toString() + '_filter'}}
{{#var modelFileName = string(entity.name).snakeCase().removeSuffix('filter').toString()}}
{{{
  exports({
    to: app.makePath('app/filters', entity.path, filterFileName + '.ts')
