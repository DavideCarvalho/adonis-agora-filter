{
  "name": "@adonis-agora/filter",
  "version": "0.8.1",
  "description": "Server-side query filtering/sorting/pagination for AdonisJS — Spatie-style input, a Lucid adapter, and field allow-listing. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-filter.git",
    "directory": "packages/core"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js",
      "default": "./dist/src/testing.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    },
    "./commands": {
      "types": "./dist/commands/main.d.ts",
      "import": "./dist/commands/main.js",
      "default": "./dist/commands/main.js"
    },
    "./filter_provider": {
      "types": "./dist/providers/filter_provider.d.ts",
      "import": "./dist/providers/filter_provider.js",
      "default": "./dist/providers/filter_provider.js"
    }
  },
  "files": [
    "dist/",
    "stubs/",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typetest.json",
    "copy:stubs": "mkdir -p dist/stubs/make/filter && cp stubs/make/filter/main.stub dist/stubs/make/filter/main.stub"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/lucid": "^22.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.5.0",
    "@adonisjs/core": "7.5.0",
    "@adonisjs/lucid": "22.4.2",
    "@tanstack/intent": "^0.3.7",
    "@types/luxon": "3.7.5",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "filter",
    "lucid",
    "query",
    "spatie",
    "pagination",
    "agora",
    "tanstack-intent"
  ]
}
